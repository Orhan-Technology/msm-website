# Password for /admin — minimum 8 characters. Required.
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie — minimum 16 characters. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Neon Postgres. Provisioned by `vercel integration add neon`; pull it locally
# with `vercel env pull .env.local`. Required.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Vercel Blob, for uploaded media. Created by `vercel blob create-store`; also
# arrives through `vercel env pull`. Required for the admin media library.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional. Defaults to https://msm.af
NEXT_PUBLIC_SITE_URL=https://msm.af

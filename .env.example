# Password for /admin — minimum 8 characters. Required.
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie — minimum 16 characters. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Defaults to ./data/msm-cms.db
SQLITE_URL=file:./data/msm-cms.db

# Optional. Defaults to https://msm.af
NEXT_PUBLIC_SITE_URL=https://msm.af

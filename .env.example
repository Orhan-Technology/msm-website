# Password for /admin — minimum 8 characters. Required.
ADMIN_PASSWORD=change-me-please

# Secret used to sign the admin session cookie — minimum 16 characters. Required.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres. In production this is the database Dokploy runs on the Hetzner
# server; locally, any Postgres works. Required.
DATABASE_URL=postgresql://user:password@host:5432/db

# Where uploaded media is stored. Optional; defaults to ./public/uploads.
# The Docker image sets /app/uploads, which Dokploy mounts as a volume.
# UPLOAD_DIR=./public/uploads

# Optional. Defaults to https://msm.af
NEXT_PUBLIC_SITE_URL=https://msm.af
